{
	"name": "ease-my-life",
	"version": "0.14.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "playwright test --config tests/playwright.config.ts",
		"test:accessibility": "playwright test --config tests/playwright.config.ts --project 'accessibility-*'",
		"test:interaction": "playwright test --config tests/playwright.config.ts --project interaction",
		"test:onboarding": "playwright test --config tests/playwright.config.ts --project onboarding",
		"test:responsive": "playwright test --config tests/playwright.config.ts --project responsive",
		"test:rules": "firebase emulators:exec --only firestore --project demo-ease-my-life \"playwright test --config tests/playwright.config.ts --project rules\"",
		"test:simulation": "playwright test --config tests/playwright.config.ts --project simulation",
		"test:sync": "playwright test --config tests/playwright.config.ts --project sync",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"firebase": "12.19.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@firebase/rules-unit-testing": "5.0.2",
		"@playwright/test": "1.62.0",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.0.4",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"firebase-tools": "15.32.1",
		"jiti": "^2.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.1.5",
		"vite-plugin-pwa": "^1.3.0"
	},
	"overrides": {
		"brace-expansion": "^5.0.8"
	}
}
